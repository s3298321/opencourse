{
  "name": "opencourse",
  "version": "0.2.0",
  "description": "OpenCourse \u2014 courses on any subject, on the desktop, with runnable exercises",
  "main": "./out/main/index.js",
  "author": "OpenCourse",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev": "ELECTRON_OVERRIDE_DIST_PATH=\"$(node scripts/electron-dist.mjs)\" electron-vite dev",
    "build:resources": "node scripts/build-spec-resources.mjs",
    "zip:course": "node scripts/zip-course.mjs",
    "zip:theme": "node scripts/zip-theme.mjs",
    "build": "npm run build:resources && electron-vite build",
    "preview": "ELECTRON_OVERRIDE_DIST_PATH=\"$(node scripts/electron-dist.mjs)\" electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "OPENCOURSE_VALIDATE_CONTENT=1 vitest run tests/content.test.ts",
    "check:exercises": "OPENCOURSE_CHECK_EXERCISES=1 vitest run tests/exercises-gate.test.ts",
    "check": "npm run typecheck && npm run test",
    "smoke": "npm run build:resources && electron-vite build && ELECTRON_OVERRIDE_DIST_PATH=\"$(node scripts/electron-dist.mjs)\" OPENCOURSE_SMOKE=1 electron .",
    "dist": "npm run build && electron-builder --mac --dir",
    "dmg": "npm run build && electron-builder --mac",
    "shots": "npm run build:resources && electron-vite build && ELECTRON_OVERRIDE_DIST_PATH=\"$(node scripts/electron-dist.mjs)\" OPENCOURSE_SHOTS=${OPENCOURSE_SHOTS:-/tmp/opencourse-shots} electron .",
    "build:icons": "node scripts/build-icons.mjs",
    "smoke:flashcards": "npm run build && ELECTRON_OVERRIDE_DIST_PATH=\"$(node scripts/electron-dist.mjs)\" OPENCOURSE_FLASHCARD_SMOKE=${OPENCOURSE_FLASHCARD_SMOKE:-/tmp/opencourse-flashcards} electron ."
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "dompurify": "^3.4.14",
    "markdown-it": "^15.0.1",
    "node-pty": "1.1.0",
    "shiki": "^4.4.3",
    "ts-fsrs": "5.4.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
