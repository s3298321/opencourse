{
  "name": "opencourse-notebook",
  "version": "0.1.0",
  "description": "OpenCourse Notebook — standalone notebooks that share local data with OpenCourse",
  "main": "./out/main/index.js",
  "author": "OpenCourse",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev": "OPENCOURSE_DEV=1 ELECTRON_OVERRIDE_DIST_PATH=\"$(node scripts/electron-dist.mjs)\" electron-vite dev --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "electron-vite build",
    "build:icons": "node scripts/build-icons.mjs",
    "dist": "npm run build && electron-builder --mac --dir"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "dompurify": "^3.4.14",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.1",
    "node-pty": "1.1.0",
    "pdfjs-dist": "^6.4.299",
    "shiki": "^4.4.3",
    "ts-fsrs": "5.4.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.8.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
