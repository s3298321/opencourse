# The address people reach the catalog at, without https://.
DOMAIN=catalog.example.org

# What the catalog calls itself, on its pages and in its emails.
OPENCOURSE_SERVER_NAME=Example Catalog
OPENCOURSE_SERVER_DESCRIPTION=Courses shared by the people who learn with us.

# Mail for sign-up codes and security notices: smtps://user:password@host:465
OPENCOURSE_SMTP_URL=
OPENCOURSE_MAIL_FROM=Example Catalog <no-reply@example.org>

# open, or closed to stop new sign-ups.
OPENCOURSE_REGISTRATION=open

# Where "Get the app" points. The default is opencourse.dev.
# OPENCOURSE_SERVER_APP_URL=https://opencourse.dev/download

# Pin a release rather than following the newest.
# OPENCOURSE_VERSION=0.1.0

# Optional server-side reading AI. Supply through a deployment secret manager.
# Keys must live outside the data volume and be backed up separately.
# OPENCOURSE_AI_ENCRYPTION_KEYS={"v1":"<64 random hex characters>"}
# OPENCOURSE_AI_ACTIVE_KEY=v1

# Document package limit and total published document storage, bytes.
# OPENCOURSE_DOCUMENT_MAX_BYTES=104857600
# OPENCOURSE_DOCUMENT_STORAGE_BYTES=10737418240
