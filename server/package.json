{
  "name": "opencourse-server",
  "version": "0.1.2",
  "private": true,
  "description": "OpenCourse server: hosts and versions courses, authenticates accounts, serves the catalog's web app",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "OPENCOURSE_SERVER_DEV=${OPENCOURSE_SERVER_DEV:-1} tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "admin": "tsx src/admin.ts",
    "seed": "tsx scripts/seed.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "ajv": "^8.20.0",
    "fastify": "^5.6.0",
    "markdown-it": "^15.0.1",
    "nodemailer": "^10.0.15",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.16",
    "esbuild": "^0.25.10",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}
