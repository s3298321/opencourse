{
  "name": "opencourse-site",
  "version": "0.1.0",
  "private": true,
  "description": "opencourse.dev: the OpenCourse website, its downloads and its documentation",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/build-resources.mjs",
    "predev": "node scripts/build-resources.mjs",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "check": "astro check && node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/markdown-it": "^14.2.0",
    "@types/prismjs": "^1.26.6",
    "astro": "^7.3.6",
    "fflate": "^0.8.3",
    "github-slugger": "^2.0.0",
    "markdown-it": "^15.0.2",
    "pagefind": "^1.5.2",
    "prismjs": "^1.30.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0"
  }
}
