---
/**
 * The Mac download for one product. With a published release it is that
 * release's DMG on GitHub; before the first release it leads to the product
 * page, which says how to build it. While a release is not signed by Apple,
 * the button says so, because it starts the download without passing the page
 * that explains how to open it.
 */
import Icon from './Icon.astro'
import { megabytes, notebookRelease, release, type Release } from '../lib/data'

interface Props {
  size?: 'lg' | 'xl'
  meta?: boolean
  note?: boolean
  class?: string
  /** OpenCourse, or the standalone notebooks app. */
  product?: 'app' | 'notebook'
}
const { size = 'xl', meta = true, note = true, class: className, product = 'app' } = Astro.props
const found: Release | null = product === 'notebook' ? notebookRelease : release
const href = found?.downloadUrl ?? (product === 'notebook' ? '/notebook' : '/download')
const label = found
  ? (product === 'notebook' ? 'Download Notebook' : 'Download for Mac')
  : (product === 'notebook' ? 'Get OpenCourse Notebook' : 'Get OpenCourse')
const noteHref = product === 'notebook' ? '/notebook#first-open' : '/download#first-open'
---
<div class:list={['download', className]}>
  {product === 'notebook'
    ? <a class={`oc-btn ${size} shine download-button`} href={href} data-notebook-download><Icon name="download" size={19} />{label}</a>
    : <a class={`oc-btn ${size} shine download-button`} href={href} data-download><Icon name="download" size={19} />{label}</a>}
  {meta && (found
    ? <span class="download-meta">Apple silicon · v{found.version} · {megabytes(found.asset!.size)}</span>
    : <span class="download-meta">No release available yet · source build instructions</span>)}
  {note && found?.unsigned && (
    <a class="download-note" href={noteHref}><Icon name="shield-check" size={14} />Not yet signed by Apple · how to open it</a>
  )}
</div>
