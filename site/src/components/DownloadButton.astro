---
/**
 * The Mac download. With a published release it is GitHub's permalink to the
 * newest DMG, which starts the download without showing GitHub at all; before
 * the first release it leads to the download page, which says what to do instead.
 * While releases are not signed by Apple, it says so, because the button starts
 * the download without passing the page that explains how to open it.
 */
import Icon from './Icon.astro'
import { SITE } from '../site.config'
import { megabytes, release } from '../lib/data'

interface Props { size?: 'lg' | 'xl'; meta?: boolean; note?: boolean; class?: string }
const { size = 'xl', meta = true, note = true, class: className } = Astro.props
---
<div class:list={['download', className]}>
  {release
    ? <a class={`oc-btn ${size} shine download-button`} href={SITE.downloadUrl} data-download><Icon name="download" size={19} />Download for Mac</a>
    : <a class={`oc-btn ${size} shine download-button`} href="/download"><Icon name="download" size={19} />Get OpenCourse</a>}
  {meta && (release
    ? <span class="download-meta">Apple silicon · v{release.version} · {megabytes(release.asset!.size)}</span>
    : <span class="download-meta">No release available yet · source build instructions</span>)}
  {note && release?.unsigned && (
    <a class="download-note" href="/download#first-open"><Icon name="shield-check" size={14} />Not yet signed by Apple · how to open it</a>
  )}
</div>
