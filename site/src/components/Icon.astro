---
import { GITHUB_MARK, ICONS, type IconName } from '../lib/icons'

interface Props { name: IconName; size?: number; class?: string }
const { name, size = 18, class: className } = Astro.props
---
{name === 'github'
  ? <svg viewBox="0 0 16 16" width={size} height={size} class:list={['icon', className]} aria-hidden="true" fill="currentColor"><path d={GITHUB_MARK} /></svg>
  : <svg viewBox="0 0 24 24" width={size} height={size} class:list={['icon', className]} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[name]} />}
