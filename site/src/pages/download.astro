---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import Sparkles from '../components/Sparkles.astro'
import DownloadButton from '../components/DownloadButton.astro'
import { SITE } from '../site.config'
import { formatDate, megabytes, release } from '../lib/data'
import { renderNotes } from '../lib/docs'

const notes = release?.notes ? renderNotes(release.notes) : ''
const build = [
  { cmd: 'git clone https://github.com/s3298321/opencourse.git' },
  { cmd: 'cd opencourse/app' },
  { cmd: 'nvm use', note: '# Node 22' },
  { cmd: 'npm install' },
  { cmd: 'npm run dmg', note: '# an unsigned build in app/dist/' }
]
---
<Base title="Download" description={`Download OpenCourse for Mac - free and open source. Apple silicon, ${SITE.minimumMacOS} or later.`} active="download">
  <section class="dl-hero">
    <div class="oc-aurora" aria-hidden="true"></div>
    <Sparkles count={8} class="hero-sparkles" />
    <div class="oc-wrap dl-inner oc-stagger">
      <img class="dl-mark" src="/brand/mark-256.png" alt="" width="112" height="112" />
      <h1 class="oc-silver-text">Download OpenCourse</h1>
      {release
        ? <p class="dl-lede">Version {release.version}, released {formatDate(release.publishedAt)}.</p>
        : <p class="dl-lede">The first release is on its way. Until then, OpenCourse builds from source in a few minutes.</p>}
      {release ? <DownloadButton meta={false} note={false} /> : <a class="oc-btn xl secondary" href={SITE.releasesUrl} rel="noopener noreferrer"><Icon name="github" size={18} />Watch for the first release</a>}
      <ul class="dl-facts">
        <li><Icon name="laptop" size={16} />Apple silicon Macs</li>
        <li><Icon name="check" size={16} />{SITE.minimumMacOS} or later</li>
        {release?.asset && <li><Icon name="package" size={16} />{megabytes(release.asset.size)} disk image</li>}
        <li><Icon name="scale" size={16} />Free · MIT License</li>
      </ul>
    </div>
  </section>

  <div class="oc-wrap dl-body">
    {release?.unsigned && (
      <section class="dl-section" id="first-open">
        <div class="callout">
          <Icon name="shield-check" size={20} />
          <div>
            <strong>Not yet signed by Apple</strong>
            <p>OpenCourse is not signed with an Apple Developer ID yet, so the first time you open it, macOS says it cannot verify the app. Close that message, open <strong>System Settings ▸ Privacy &amp; Security</strong>, scroll to the note about OpenCourse and choose <strong>Open Anyway</strong>. You do this once for each version you download.</p>
          </div>
        </div>
      </section>
    )}

    {release && (
      <section class="dl-section oc-reveal">
        <h2>Install it</h2>
        <ol class="steps">
          <li class="oc-panel"><span class="how-n">1</span><div><strong>Open the download</strong><p>Double-click <code>OpenCourse-mac-arm64.dmg</code> in your Downloads folder.</p></div></li>
          <li class="oc-panel"><span class="how-n">2</span><div><strong>Drag it to Applications</strong><p>Drop the OpenCourse icon onto the Applications folder in the window that opens.</p></div></li>
          <li class="oc-panel"><span class="how-n">3</span><div><strong>Open it</strong><p>Start OpenCourse from Applications or Spotlight{release.unsigned ? <>, allow it once as <a href="#first-open">described above</a>,</> : ''} and import or add your first course.</p></div></li>
        </ol>
      </section>
    )}

    {release && notes && (
      <section class="dl-section oc-reveal">
        <div class="dl-section-head"><h2>What's new in {release.version}</h2><a class="more-link" href={release.url} rel="noopener noreferrer">On GitHub<Icon name="arrow-up-right" size={15} /></a></div>
        <div class="oc-prose release-notes" set:html={notes} />
      </section>
    )}

    <section class="dl-section oc-reveal">
      <h2>Build it yourself</h2>
      <p class="muted">OpenCourse is one open-source repository. With Node 22 and the Xcode Command Line Tools, this produces the same app:</p>
      <div class="code-card">
        <button type="button" class="oc-btn secondary sm copy" data-copy={build.map((line) => line.cmd).join('\n')}><Icon name="copy" size={14} /><span data-copy-label>Copy</span></button>
        <pre><code>{build.map((line) => <span class="line"><span class="prompt">$</span> {line.cmd}{line.note && <span class="comment">{'  '}{line.note}</span>}{'\n'}</span>)}</code></pre>
      </div>
    </section>

    <section class="dl-section dl-more oc-reveal">
      <a class="oc-card oc-glow more-card" data-glow href={SITE.releasesUrl} rel="noopener noreferrer"><Icon name="git-branch" /><div><strong>Every release</strong><span>Older versions and notes on GitHub</span></div><Icon name="arrow-up-right" size={16} /></a>
      <a class="oc-card oc-glow more-card" data-glow href="/docs/getting-started"><Icon name="graduation-cap" /><div><strong>Getting started</strong><span>Your first course, step by step</span></div><Icon name="arrow-right" size={16} /></a>
      <a class="oc-card oc-glow more-card" data-glow href={SITE.catalogUrl}><Icon name="book-open" /><div><strong>Find a course</strong><span>Browse the public catalog</span></div><Icon name="arrow-up-right" size={16} /></a>
    </section>
  </div>
</Base>
