---
import { Picture } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import Sparkles from '../components/Sparkles.astro'
import DownloadButton from '../components/DownloadButton.astro'
import GitHubButton from '../components/GitHubButton.astro'
import WindowFrame from '../components/WindowFrame.astro'
import { SITE } from '../site.config'
import { compactNumber, generated, release } from '../lib/data'
import sidechat from '../assets/screens/07-sidechat-ask-answer.png'
import viz from '../assets/screens/11-viz.png'
import quiz from '../assets/screens/12-quiz.png'
import workbench from '../assets/screens/17-workbench-pass.png'
import documents from '../assets/screens/documents-reader.png'
import coach from '../assets/screens/coach-launcher.png'
import authoring from '../assets/screens/course-editor-ai.png'

const subjects = ['Data science', 'Operating systems', 'French for travel', 'LLVM and compilers', 'Statistics', 'Music theory', 'Python', 'Organic chemistry', 'Photography', 'Linear algebra', 'C programming', 'World history', 'Machine learning', 'Public speaking', 'SQL', 'Philosophy of mind']
const featured = generated.featured.length >= 3 ? generated.featured.slice(0, 6) : []
const faq = [
  { q: 'Is OpenCourse free?', a: 'Yes. The desktop app and learning server are free and open source under the MIT License. Optional local AI uses your OpenAI API key or ChatGPT connection; provider charges and plan limits apply. Reading chat for server content uses a separate API key configured on that server.' },
  { q: 'Which Macs does it run on?', a: `Macs with Apple silicon, on ${SITE.minimumMacOS} or later.` },
  { q: 'Do I need an account?', a: 'No account is needed to import courses or PDFs, write personal notebooks, or create courses. Enrolling in or publishing content on a server requires an account there. Registration availability depends on the server.' },
  { q: 'Where does learning material come from?', a: 'Import a course ZIP or PDF, add courses and documents from a connected server, or write a course in the built-in editor. The editor can also draft and revise a course with AI. You review the changes and choose when to save.' },
  { q: 'What can Coach see?', a: 'When you use Coach, it can inspect your current lesson, PDF page, selections and open notebooks, including unsaved notebook edits. It can search and read local material and accessible content on connected servers, with quiz answers and exercise solutions excluded. Each coach keeps its own memory between conversations. Open it from the floating Coaches button; there is no separate Coach workspace or file browser.' },
  { q: 'Are personal notebooks the same as Python notebooks?', a: 'No. Personal notebooks are autosaving Markdown pages in their own windows, with images, search and optional read-only AI chat. They stay on your Mac and can link to a course or PDF. Python notebooks belong to a course and run code using its Python environment.' },
  { q: 'Can I study in a browser?', a: 'Yes. A connected learning server provides a web reader for courses and PDFs, quizzes, flashcards and reading chat, with enrolled progress and reading conversations synchronized with the desktop app. Coding exercises, projects, Python notebooks, personal notebooks, course authoring and Coach use the desktop app.' },
  { q: 'Is it only for programming?', a: 'No. Lessons, pictures, interactive visualizations, quizzes and flashcards work for any subject. Programming courses also get checked Python exercises and executable notebooks with bundled Python. Projects can use other languages with tools you set up yourself.' },
  { q: 'What happens to my data?', a: 'Imported content, personal notebooks, Coach memory and local conversations stay on your Mac unless you use AI or explicitly publish content. Enrolled server content synchronizes progress and reading conversations with that server. AI sends relevant material to OpenAI; Coach can also read accessible server material through your local AI connection. The app collects no usage analytics.' },
  { q: 'Can I run my own server?', a: 'Yes. The learning server is part of the same open-source project. Run it with Docker for a class, team or community, with course and PDF publishing, accounts, web learning, synchronization and administration. The self-hosting guide covers setup and backups.' }
]
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OpenCourse',
  applicationCategory: 'EducationalApplication',
  operatingSystem: `macOS (${SITE.minimumMacOS} or later)`,
  description: SITE.description,
  url: SITE.url,
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  ...(release ? { softwareVersion: release.version, downloadUrl: SITE.downloadUrl } : {})
}
---
<Base active="features" jsonLd={jsonLd}>
  <!-- ============ hero ============ -->
  <section class="hero">
    <div class="oc-aurora" aria-hidden="true"></div>
    <Sparkles count={10} class="hero-sparkles" />
    <div class="oc-wrap hero-inner">
      <div class="hero-copy oc-stagger">
        <a class="hero-eyebrow" href={SITE.repoUrl} rel="noopener noreferrer"><span class="oc-sparkle"></span>Free and open source · for Mac<Icon name="arrow-right" size={14} /></a>
        <h1 class="hero-title"><span class="oc-silver-text">Learn anything,</span> <span class="oc-silver-text">locally</span></h1>
        <p class="hero-lede">Study courses and PDFs, keep your own notebooks, and talk through ideas with Coach. Practice with quizzes, flashcards and code, or create a course of your own.</p>
        <div class="hero-actions">
          <DownloadButton />
          <a class="oc-btn xl secondary" href={SITE.catalogUrl} target="_blank" rel="noopener noreferrer">Browse the catalog<Icon name="arrow-right" size={18} /></a>
        </div>
        <ul class="hero-trust">
          <li><Icon name="check" size={15} />MIT licensed</li>
          <li><Icon name="check" size={15} />No account needed</li>
          <li><Icon name="check" size={15} />Offline study · optional sync</li>
        </ul>
      </div>
      <div class="hero-visual">
        <div class="hero-glow" aria-hidden="true"></div>
        <WindowFrame src={sidechat} alt="A lesson about Python's asyncio in OpenCourse, with the side chat open beside it: the learner highlighted a sentence, asked about it, and the answer cites two pages from docs.python.org." eager class="hero-window" />
        <div class="float-chip chip-pass oc-float" aria-hidden="true"><Icon name="circle-check" size={16} /><span><strong>3 passed</strong> in 1.53s</span></div>
        <div class="float-chip chip-quiz oc-float" aria-hidden="true"><span class="chip-dot"></span><span>Quiz · <strong>4 of 5</strong></span></div>
        <div class="float-chip chip-cite oc-float" aria-hidden="true"><span class="cite-n">1</span><span>docs.python.org</span></div>
      </div>
    </div>
  </section>

  <!-- ============ any subject ============ -->
  <section class="subjects" aria-label="Any subject">
    <p class="subjects-label oc-eyebrow">Courses can cover any subject</p>
    <div class="marquee">
      <ul class="marquee-track">
        {subjects.map((s) => <li><span class="oc-sparkle"></span>{s}</li>)}
      </ul>
      <ul class="marquee-track" aria-hidden="true">
        {subjects.map((s) => <li><span class="oc-sparkle"></span>{s}</li>)}
      </ul>
    </div>
  </section>

  <!-- ============ features ============ -->
  <section id="features" class="section">
    <div class="oc-wrap">
      <header class="section-head oc-reveal">
        <span class="oc-eyebrow">Features</span>
        <h2>Read, write,<br /> practice and review</h2>
        <p>Keep downloaded courses, PDFs and personal notebooks on your Mac. Connect a learning server to continue enrolled reading on the web; AI features require an internet connection.</p>
      </header>
      <div class="bento">
        <article class="bento-card bento-lessons oc-card oc-glow oc-reveal" data-glow>
          <div class="bento-text">
            <span class="bento-icon"><Icon name="book-open" /></span>
            <h3>Interactive lessons</h3>
            <p>Lessons combine text, images and interactive visualizations. Read an explanation and step through its examples in the same view.</p>
          </div>
          <div class="bento-shot"><Picture src={viz} alt="A visualization stepping through the life of a coroutine, inside a lesson." formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 600px" /></div>
        </article>
        <article class="bento-card oc-card oc-glow oc-reveal" data-glow>
          <span class="bento-icon"><Icon name="code-xml" /></span>
          <h3>Coding exercises with checks</h3>
          <p>Write and run Python in the built-in editor and terminal. Each exercise includes checks you can run on your Mac, using the bundled interpreter.</p>
          <div class="mock-term" aria-hidden="true">
            <span class="mock-line muted">$ run checks</span>
            <span class="mock-line"><span class="ok">✓</span> results come back in order</span>
            <span class="mock-line"><span class="ok">✓</span> finishes under 1.2 s</span>
            <span class="mock-line"><span class="ok">✓</span> no task left running</span>
            <span class="mock-line ok-strong">3 passed in 1.53s</span>
          </div>
        </article>
        <article class="bento-card oc-card oc-glow oc-reveal" data-glow>
          <span class="bento-icon"><Icon name="message-square-text" /></span>
          <h3>Ask about a lesson</h3>
          <p>Highlight a passage and ask a question in the side chat. The assistant can find relevant course passages, with quiz answers and exercise solutions excluded.</p>
          <div class="mock-chat" aria-hidden="true">
            <div class="mock-quote">only the blocking call is handed to a worker</div>
            <div class="mock-bubble">Why doesn't the loop block here?</div>
            <div class="mock-answer">Because <code>to_thread</code> runs it elsewhere and <code>await</code> hands the result back.<sup>1</sup></div>
          </div>
        </article>
        <article class="bento-card oc-card oc-glow oc-reveal" data-glow>
          <span class="bento-icon"><Icon name="mic" /></span>
          <h3>Voice practice with Coach</h3>
          <p>Open the floating Coaches button and start talking. Your coach can read the lesson, PDF, notebook or selection you are working on, search accessible learning material, and keep its own memory between conversations.</p>
          <div class="mock-voice" aria-hidden="true">
            <div class="wave">{Array.from({ length: 28 }, () => <span />)}</div>
            <p><strong>You</strong> euh… le chien?</p>
            <p class="muted"><strong>Coach</strong> exactement. Et « cat » ?</p>
          </div>
        </article>
        <article class="bento-card oc-card oc-glow oc-reveal" data-glow>
          <span class="bento-icon"><Icon name="layers" /></span>
          <h3>Flashcards with spaced review</h3>
          <p>Review cards from completed lessons and rate how well you remember each answer. Your ratings determine when each card is due again.</p>
          <div class="mock-cards" aria-hidden="true">
            <div class="mock-card back"></div>
            <div class="mock-card"><span class="muted">What does SSA stand for?</span><span class="mock-rate"><i>Again</i><i>Hard</i><i class="on">Good</i><i>Easy</i></span></div>
          </div>
        </article>
        <article class="bento-card oc-card oc-glow oc-reveal" data-glow>
          <span class="bento-icon"><Icon name="file-text" /></span>
          <h3>Read and ask about PDFs</h3>
          <p>Import PDFs into Documents, find passages and navigate the outline. Highlight text to ask a question, with page references that take you back to the source.</p>
          <a class="more-link" href="/docs/getting-started#read-pdfs">Explore Documents<Icon name="arrow-right" size={15} /></a>
        </article>
        <article class="bento-card oc-card oc-glow oc-reveal" data-glow>
          <span class="bento-icon"><Icon name="pen-line" /></span>
          <h3>Personal Markdown notebooks</h3>
          <p>Write in separate windows with autosaving pages and pasted or dropped images. Search across your notebooks, link one to a course or PDF, and ask about your notes without AI changing them.</p>
          <a class="more-link" href="/docs/getting-started#personal-notebooks">Start a notebook<Icon name="arrow-right" size={15} /></a>
        </article>
        <article class="bento-card oc-card oc-glow oc-reveal" data-glow>
          <span class="bento-icon"><Icon name="globe" /></span>
          <h3>Continue learning on the web</h3>
          <p>A connected server keeps enrolled progress and reading conversations in sync. Read courses and PDFs, take quizzes and review flashcards in its browser player.</p>
          <a class="more-link" href="/docs/getting-started#learn-on-the-web">Desktop and web<Icon name="arrow-right" size={15} /></a>
        </article>
        <article class="bento-card oc-card oc-glow oc-reveal" data-glow>
          <span class="bento-icon"><Icon name="palette" /></span>
          <h3>Custom themes</h3>
          <p>Change the app's colours, fonts and background images. Import a theme or create one using the documented theme format.</p>
          <div class="mock-swatches" aria-hidden="true"><span class="sw sw1"></span><span class="sw sw2"></span><span class="sw sw3"></span><span class="sw sw4"></span><span class="sw sw5"></span></div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ deep dives ============ -->
  <section class="section dives">
    <div class="oc-wrap">
      <article class="dive oc-reveal">
        <div class="dive-text">
          <span class="oc-eyebrow">Documents</span>
          <h2>Bring your reading material</h2>
          <p>Keep PDFs beside your courses. Search the text, follow the outline and reopen where you left off. Ask about a selected passage or let reading chat retrieve relevant pages.</p>
          <ul class="ticks">
            <li><Icon name="check" size={16} />Local imports and server document catalogs</li>
            <li><Icon name="check" size={16} />Page references you can open from chat</li>
            <li><Icon name="check" size={16} />Personal notebooks linked to your reading</li>
          </ul>
        </div>
        <WindowFrame src={documents} alt="A PDF open in Documents with its outline and reading chat beside the page." />
      </article>
      <article class="dive reverse oc-reveal">
        <div class="dive-text">
          <span class="oc-eyebrow">Coach in 0.7.0</span>
          <h2>Talk about what you are learning</h2>
          <p>Your coaches are a click away while you read or write. Start a spoken conversation, ask about what is on screen, and keep studying as the coach follows your context.</p>
          <ul class="ticks">
            <li><Icon name="check" size={16} />Reads lessons, PDF pages and selected passages</li>
            <li><Icon name="check" size={16} />Includes open notebook edits when reading a page</li>
            <li><Icon name="check" size={16} />Searches your library and accessible server content</li>
          </ul>
        </div>
        <WindowFrame src={coach} alt="The floating Coaches panel with a saved coach, search and a New coach button, above the notebook launcher." />
      </article>
      <article class="dive oc-reveal">
        <div class="dive-text">
          <span class="oc-eyebrow">Practice</span>
          <h2>Write, run and check Python code</h2>
          <p>Programming exercises open in a workbench with an editor, a terminal and the course's own checks. Run them as often as you like; when they pass, the exercise is done.</p>
          <ul class="ticks">
            <li><Icon name="check" size={16} />Python in a virtual environment per course</li>
            <li><Icon name="check" size={16} />Bundled Python, with no interpreter installation</li>
            <li><Icon name="check" size={16} />Executable Python notebooks, plus projects with your own tools</li>
          </ul>
        </div>
        <WindowFrame src={workbench} alt="The exercise workbench: the brief on the left, Python code in the editor, and all three checks passing in the terminal." />
      </article>
      <article class="dive reverse oc-reveal">
        <div class="dive-text">
          <span class="oc-eyebrow">Review</span>
          <h2>Quizzes with answer explanations</h2>
          <p>Check your understanding with quizzes and review the explanation for each answer. Lessons can include objectives and key takeaways to help you revisit the material.</p>
          <ul class="ticks">
            <li><Icon name="check" size={16} />Single and multiple choice, with explanations</li>
            <li><Icon name="check" size={16} />Flashcards with spaced review</li>
            <li><Icon name="check" size={16} />Projects that span several lessons</li>
          </ul>
        </div>
        <WindowFrame src={quiz} alt="A lesson's key takeaways followed by a quiz; a wrong answer is explained in place." />
      </article>
    </div>
  </section>

  <section class="section dives">
    <div class="oc-wrap">
      <article class="dive oc-reveal">
        <div class="dive-text">
          <span class="oc-eyebrow">Authoring</span>
          <h2>Turn an idea into a course</h2>
          <p>Write by hand or ask AI to draft and revise lessons, quizzes and exercises. Review the course in a live preview; edits stay in memory until you save.</p>
          <a class="more-link" href="/docs/getting-started#write-a-course">Create your first course<Icon name="arrow-right" size={15} /></a>
        </div>
        <WindowFrame src={authoring} alt="The course editor with a lesson preview and AI authoring assistant." />
      </article>
    </div>
  </section>

  <!-- ============ author and share ============ -->
  <section class="section share">
    <div class="oc-wrap">
      <header class="section-head oc-reveal">
        <span class="oc-eyebrow">Course authoring</span>
        <h2>Create and share courses</h2>
        <p>Write and preview a course, use AI to draft or revise it, then export a ZIP or publish to a learning server. Share PDFs too. Learners choose when to accept new versions.</p>
      </header>
      <div class="share-grid oc-stagger">
        <article class="oc-panel oc-edge share-card">
          <span class="bento-icon"><Icon name="pen-line" /></span>
          <h3>Edit a course</h3>
          <p>Add modules, lessons, quizzes, exercises and flashcards. Ask the authoring assistant to draft or revise the course, inspect its preview, and save when you are ready.</p>
          <a class="more-link" href="/docs/course-format">The course format<Icon name="arrow-right" size={15} /></a>
        </article>
        <article class="oc-panel oc-edge share-card">
          <span class="bento-icon"><Icon name="cloud-upload" /></span>
          <h3>Publish to a catalog</h3>
          <p>Publish courses from the editor and PDFs from Documents. People with an account on that server can enroll, study in the app or browser, and accept updates while keeping progress.</p>
          <a class="more-link" href={SITE.catalogUrl} target="_blank" rel="noopener noreferrer">Visit the catalog<Icon name="arrow-up-right" size={15} /></a>
        </article>
        <article class="oc-panel oc-edge share-card">
          <span class="bento-icon"><Icon name="server" /></span>
          <h3>Run a learning server</h3>
          <p>Host courses and PDFs for a class, team or community. The server includes accounts, a web reader, quizzes, flashcards, reading chat, learning sync, moderation and administration.</p>
          <a class="more-link" href="/docs/self-hosting">Self-hosting guide<Icon name="arrow-right" size={15} /></a>
        </article>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section featured">
      <div class="oc-wrap">
        <header class="section-head row oc-reveal">
          <div>
            <span class="oc-eyebrow">From the catalog</span>
            <h2>Most downloaded courses</h2>
          </div>
          <a class="oc-btn secondary" href={SITE.catalogUrl} target="_blank" rel="noopener noreferrer">All courses<Icon name="arrow-up-right" size={16} /></a>
        </header>
        <ul class="featured-grid oc-stagger">
          {featured.map((course) => (
            <li>
              <a class="featured-card oc-card oc-glow" data-glow href={`${SITE.catalogUrl}/courses/${encodeURIComponent(course.id)}`} target="_blank" rel="noopener noreferrer">
                <div class="featured-cover">{course.cover ? <img src={course.cover} alt="" loading="lazy" /> : <span class="oc-sparkle" />}</div>
                <div class="featured-body">
                  <h3>{course.title}</h3>
                  <p class="muted">{[course.subject, `${course.lessonCount} lessons`].filter(Boolean).join(' · ')}</p>
                  <p class="featured-meta"><Icon name="users" size={14} />{compactNumber(course.downloads)}<span>by {course.publisher}</span></p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ============ privacy ============ -->
  <section class="section privacy">
    <div class="oc-wrap privacy-inner oc-reveal">
      <div class="privacy-art" aria-hidden="true">
        <img src="/brand/mark-256.png" alt="" width="128" height="128" />
      </div>
      <div class="privacy-text">
        <span class="oc-eyebrow">Data and privacy</span>
        <h2>Local storage and optional connections</h2>
        <div class="privacy-points">
          <p><Icon name="hard-drive" size={18} /><span><strong>Local study, optional server sync.</strong> Imported courses, PDFs, personal notebooks and Coach memory live on your Mac. Enrolled server content synchronizes progress and reading conversations with that server.</span></p>
          <p><Icon name="key-round" size={18} /><span><strong>Separate AI connections.</strong> Local chat, notebooks, Coach and authoring use your local OpenAI connection. Reading chat for server content uses credentials configured on that server, without falling back to your local key.</span></p>
          <p><Icon name="shield-check" size={18} /><span><strong>No usage analytics.</strong> The app and website do not collect usage analytics. Catalog connections and app update checks are optional.</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ open source ============ -->
  <section class="section open">
    <div class="oc-wrap">
      <div class="open-card oc-panel oc-edge oc-glow oc-reveal" data-glow>
        <div class="open-text">
          <span class="oc-eyebrow">Open source</span>
          <h2>Source code and documentation</h2>
          <p>The app, learning server, file formats and website are maintained in one MIT-licensed repository. You can read the code, report issues and contribute changes on GitHub.</p>
          <div class="open-actions">
            <GitHubButton label="Star on GitHub" class="lg" />
            <a class="oc-btn secondary" href={SITE.repoUrl} rel="noopener noreferrer"><Icon name="code-xml" size={16} />Read the code</a>
          </div>
        </div>
        <dl class="open-stats">
          <div><dt>Stars</dt><dd data-count={generated.repo?.stars ?? 0}>{generated.repo ? compactNumber(generated.repo.stars) : '–'}</dd></div>
          <div><dt>License</dt><dd>MIT</dd></div>
          <div><dt>Platform</dt><dd>macOS</dd></div>
          <div><dt>Price</dt><dd>Free</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ faq ============ -->
  <section class="section faq">
    <div class="oc-wrap faq-inner">
      <header class="section-head oc-reveal">
        <span class="oc-eyebrow">Questions</span>
        <h2>Good to know</h2>
      </header>
      <div class="faq-list oc-reveal">
        {faq.map((item, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{item.q}<Icon name="chevron-down" size={18} /></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ final call ============ -->
  <section class="final">
    <div class="oc-aurora" aria-hidden="true"></div>
    <Sparkles count={10} class="final-sparkles" />
    <div class="oc-wrap final-inner oc-reveal">
      <img class="final-mark" src="/brand/mark-256.png" alt="" width="96" height="96" />
      <h2 class="oc-silver-text">Download OpenCourse</h2>
      <p>Courses, PDFs, notebooks and a coach, together on your Mac.</p>
      <DownloadButton />
    </div>
  </section>
</Base>
